{
  "descricao": "Como iam_acentuado, com teto de 25% de ocorrencias acentuadas por palavra (iam_acentuado_teto25), para reduzir o vazamento do acento para palavras sem acento (ACHADOS 10)",
  "save_path": "./model_iam_acentuado_teto25",
  "dados": {
    "dataset": "iam_acentuado",
    "split": "./iam_acentuado_teto25",
    "imagens": "./DiffusionPen/iam_data/words",
    "max_samples": 0,
    "preproc": "iam",
    "iam_originais": 1.0
  },
  "modelo": {
    "pesos_iniciais": "./DiffusionPen/diffusionpen_iam_model_path/models",
    "extrator_estilo": "./DiffusionPen/style_models/iam_style_diffusionpen.pth",
    "stable_diffusion": "stable-diffusion-v1-5/stable-diffusion-v1-5"
  },
  "treino": {
    "epocas_por_bloco": 2,
    "epocas_total": 10,
    "lr": 2e-05,
    "batch_size": 32,
    "adamw_eps": 1e-06,
    "clip_grad_norm": 1.0,
    "ema_beta": 0.995,
    "ema_inicio": 2000,
    "texto_max_len": 40
  },
  "execucao": {
    "device": "cuda:0",
    "num_workers": 8,
    "save_every_steps": 500,
    "abort_after": 300
  },
  "amostras": {
    "palavras": [
      "nacao",
      "nação",
      "coracao",
      "coração",
      "pao",
      "pão",
      "avo",
      "avó",
      "voce",
      "você",
      "the",
      "and",
      "with"
    ],
    "estilos": 4,
    "seed": 42,
    "estilo_de": "iam"
  }
}
