{
  "descricao": "Acentos sinteticos sobre escrita REAL do IAM (base iam_acentuado_teto25 + pares de scripts/criar_pares_iam.py), sem nada gerado pelo DiffusionPen (a geracao estragava a letra: ACHADOS 13, adendo 3), com todas as palavras originais do iam_train_val, peso 5 no acento (acentuada e par) e peso 2 na zona vazia acima/abaixo do corpo (todas as amostras, contra acento que o texto nao pede). Amostras com palavras pt de VALIDACAO; teste so no fim",
  "save_path": "./model_iam_acentuado_pares",
  "dados": {
    "dataset": "iam_acentuado",
    "split": "./iam_acentuado_teto25_pares",
    "imagens": "./DiffusionPen/iam_data/words",
    "max_samples": 0,
    "preproc": "iam",
    "iam_originais": 1.0
  },
  "modelo": {
    "pesos_iniciais": "./DiffusionPen/diffusionpen_iam_model_path/models",
    "extrator_estilo": "./DiffusionPen/style_models/iam_style_diffusionpen.pth",
    "stable_diffusion": "stable-diffusion-v1-5/stable-diffusion-v1-5"
  },
  "treino": {
    "epocas_por_bloco": 4,
    "epocas_total": 12,
    "lr": 2e-05,
    "batch_size": 32,
    "adamw_eps": 1e-06,
    "clip_grad_norm": 1.0,
    "ema_beta": 0.995,
    "ema_inicio": 2000,
    "texto_max_len": 40,
    "peso_acento": 5,
    "peso_zona": 2
  },
  "execucao": {
    "device": "cuda:0",
    "num_workers": 8,
    "save_every_steps": 500,
    "abort_after": 300
  },
  "amostras": {
    "palavras": [
      "fogão",
      "fogao",
      "câmera",
      "camera",
      "opção",
      "opcao",
      "módulo",
      "modulo",
      "provável",
      "provavel",
      "bolo"
    ],
    "estilos": 4,
    "seed": 42,
    "estilo_de": "iam"
  }
}
